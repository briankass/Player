<ContentDialog
    x:Class="GlassPlayer.MatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GlassPlayer.Models"
    Title="Find a match"
    PrimaryButtonText="Use this"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="820" Spacing="10">
        <SelectorBar x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged">
            <SelectorBarItem Text="Song" Tag="song" IsSelected="True"/>
            <SelectorBarItem Text="Whole album" Tag="album"/>
        </SelectorBar>

        <TextBlock x:Name="FileText" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ArtistBox" Header="Artist" KeyDown="Box_KeyDown"/>
            <TextBox x:Name="TitleBox" Grid.Column="1" Header="Song title" KeyDown="Box_KeyDown"/>
            <TextBox x:Name="AlbumBox" Grid.Column="2" Header="Album (optional)" KeyDown="Box_KeyDown"/>
            <Button x:Name="SearchButton" Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                    Click="Search_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    <TextBlock Text="Search"/>
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16"/>
            <TextBlock x:Name="StatusText" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <ListView x:Name="Results" Height="400" SelectionMode="Single" SelectionChanged="Results_SelectionChanged"
                  DoubleTapped="Results_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Candidate">
                    <Grid Padding="0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="56" Height="56" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE93C;" FontSize="20" Opacity="0.4"/>
                            <Image Source="{x:Bind Cover}" Stretch="UniformToFill"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Line1}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Line2}" Opacity="0.8" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Line3}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="ApplyNote" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
