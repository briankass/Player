<Page
    x:Class="GlassPlayer.Pages.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GlassPlayer.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Height="250" CornerRadius="8,0,0,0" RequestedTheme="Dark">
            <Rectangle x:Name="HeaderColor" Fill="#FF2B4F81"/>
            <Image x:Name="HeaderBg" Stretch="UniformToFill" VerticalAlignment="Center"/>
            <Rectangle>
                <Rectangle.Fill>
                    <AcrylicBrush TintColor="#FF101010" TintOpacity="0.4" TintLuminosityOpacity="0.3" FallbackColor="#E0181818"/>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Padding="40,28" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="CoverBox" Width="180" Height="180" CornerRadius="10" Background="#33FFFFFF">
                    <FontIcon x:Name="CoverGlyph" Glyph="&#xE728;" FontSize="64" Opacity="0.8"/>
                    <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="KindText" Text="PLAYLIST" FontSize="12" Opacity="0.7" CharacterSpacing="100"/>
                    <TextBlock x:Name="NameText" Style="{StaticResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DetailsText" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Play_Click" Padding="18,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock Text="Play"/>
                            </StackPanel>
                        </Button>
                        <Button Click="Shuffle_Click" Padding="18,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                                <TextBlock Text="Shuffle"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton" Padding="12,8" ToolTipService.ToolTip="More">
                            <FontIcon Glyph="&#xE712;" FontSize="14"/>
                            <Button.Flyout>
                                <MenuFlyout x:Name="MoreMenu">
                                    <MenuFlyoutItem Text="Add to queue" Click="AddQueue_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Save as a new playlist…" Click="SaveCopy_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Export as .m3u…" Click="Export_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="UserSeparator"/>
                                    <MenuFlyoutItem x:Name="RenameItem" Text="Rename…" Click="Rename_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="DeleteItem" Text="Delete playlist" Click="Delete_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="TrackList" Padding="28,12,28,24" SelectionMode="Single" IsItemClickEnabled="True"
                      ItemClick="TrackList_ItemClick" RightTapped="TrackList_RightTapped"
                      DragItemsCompleted="TrackList_DragItemsCompleted">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Padding="4,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Artist}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind DisplayAlbum}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" Opacity="0.75" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
        </Grid>
    </Grid>
</Page>
