<Page
    x:Class="GlassPlayer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="40,24,40,32" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="Library" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEC4F;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Music folders"/>
                            <TextBlock Text="Local folders, mapped drives or NAS paths like \\nas\music" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="AddMusicFolder_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                <TextBlock Text="Add folder"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="MusicFolderList" Spacing="4" Margin="36,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B2;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Video folders"/>
                            <TextBlock Text="MP4, MKV, AVI, MOV, WMV, WebM… Subtitles (.srt) next to a video are picked up automatically" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="AddVideoFolder_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                <TextBlock Text="Add folder"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="VideoFolderList" Spacing="4" Margin="36,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72C;" FontSize="20"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Library"/>
                        <TextBlock x:Name="ScanText" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="RescanButton" Grid.Column="2" Content="Rescan all" Click="Rescan_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8EC;" FontSize="20"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Fix metadata &amp; album art"/>
                        <TextBlock Text="Find missing tags and covers on MusicBrainz and the Cover Art Archive" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open" Click="Metadata_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="18">
                    <!-- effect -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Glass effect"/>
                            <TextBlock Text="Blur glass and Clear glass are truly see-through. Mica and Acrylic are Windows materials and always stay fairly solid."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Name="EffectBox" Grid.Column="2" MinWidth="170" VerticalAlignment="Center"
                                  SelectionChanged="Glass_Changed">
                            <ComboBoxItem Content="Mica"/>
                            <ComboBoxItem Content="Mica Alt"/>
                            <ComboBoxItem Content="Acrylic"/>
                            <ComboBoxItem Content="Acrylic (thin)"/>
                            <ComboBoxItem Content="Solid (no glass)"/>
                            <ComboBoxItem Content="Blur glass"/>
                            <ComboBoxItem Content="Clear glass"/>
                        </ComboBox>
                    </Grid>

                    <!-- tint -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE2B1;" FontSize="20" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <Grid>
                                <TextBlock Text="Tint colour" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <ComboBox x:Name="TintModeBox" MinWidth="170" SelectionChanged="Glass_Changed">
                                        <ComboBoxItem Content="Default"/>
                                        <ComboBoxItem Content="From album art"/>
                                        <ComboBoxItem Content="Custom colour"/>
                                    </ComboBox>
                                    <Button ToolTipService.ToolTip="Pick any colour">
                                        <FontIcon Glyph="&#xE790;" FontSize="14"/>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="TintPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                             IsColorChannelTextInputVisible="False" ColorChanged="TintPicker_ColorChanged"/>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="8"/>
                        </StackPanel>
                    </Grid>

                    <!-- sliders -->
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <FontIcon Glyph="&#xE771;" FontSize="20"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tint strength"/>
                            <TextBlock Text="How much colour is mixed in" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                        <Slider x:Name="TintSlider" Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Slider_Changed"/>
                        <TextBlock x:Name="TintValue" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7"/>

                        <FontIcon Grid.Row="1" Glyph="&#xE706;" FontSize="20"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Frosting"/>
                            <TextBlock Text="Lower = clearer, more see-through" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                        <Slider x:Name="LumSlider" Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Slider_Changed"/>
                        <TextBlock x:Name="LumValue" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7"/>

                        <FontIcon Grid.Row="2" Glyph="&#xE8A9;" FontSize="20"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Panel opacity"/>
                            <TextBlock Text="Darkness of the content area and player bar" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                        <Slider x:Name="SurfaceSlider" Grid.Row="2" Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Slider_Changed"/>
                        <TextBlock x:Name="SurfaceValue" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7"/>
                    </Grid>

                    <!-- keep active + reset -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Keep glass when the window isn't focused"/>
                            <TextBlock Text="Windows normally switches to a flat colour when you click away" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="KeepActiveSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Glass_Toggled"/>
                    </Grid>

                    <Grid>
                        <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="36,0,140,0"
                                   Text="No glass at all? Turn on Windows Settings › Personalization › Colors › Transparency effects. Energy saver also turns it off."/>
                        <Button Content="Reset to defaults" HorizontalAlignment="Right" Click="ResetGlass_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Playback" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B1;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Crossfade"/>
                            <TextBlock Text="Blend the end of one song into the start of the next (music only)" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="CrossfadeSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Crossfade_Changed"/>
                    </Grid>
                    <Grid ColumnSpacing="16" Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="CrossfadeSlider" Minimum="1" Maximum="12" StepFrequency="1" ValueChanged="CrossfadeSlider_ValueChanged"/>
                        <TextBlock x:Name="CrossfadeValue" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9E9;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Equalizer"/>
                            <TextBlock Text="10 bands, ±12 dB (music only)" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                        <ComboBox x:Name="EqPresetBox" Grid.Column="2" MinWidth="150" VerticalAlignment="Center" Margin="0,0,12,0"
                                  SelectionChanged="EqPreset_Changed"/>
                        <ToggleSwitch x:Name="EqSwitch" Grid.Column="3" OnContent="" OffContent="" MinWidth="0" Toggled="Eq_Toggled"/>
                    </Grid>
                    <Grid x:Name="EqBands" Margin="36,0,0,0" ColumnSpacing="4"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Startup &amp; tray" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Start with Windows"/>
                            <TextBlock Text="Open Glass Player when you sign in" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Startup_Toggled"/>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE921;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Start minimized"/>
                            <TextBlock Text="When started with Windows, stay out of the way (in the tray if that's on)" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="StartMinSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Tray_Toggled"/>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE73F;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Minimize to system tray"/>
                            <TextBlock Text="Minimizing hides the window; click the tray icon to bring it back" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="MinTraySwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Tray_Toggled"/>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE711;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Close to system tray"/>
                            <TextBlock Text="The close button keeps music playing in the tray. Use Exit in the tray menu to quit." Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="CloseTraySwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Tray_Toggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE895;" FontSize="20"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="VersionText"/>
                        <TextBlock Text="Updates are checked automatically when the app starts" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Check for updates" Click="Update_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Credits"/>
                    <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="Lyrics from LRCLIB (lrclib.net). Metadata from MusicBrainz, cover art from the Cover Art Archive. Tag reading and writing by TagLib#."/>
                    <HyperlinkButton Content="Source code on GitHub" NavigateUri="https://github.com/briankass/Player" Padding="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
