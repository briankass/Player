<Page
    x:Class="GlassPlayer.Pages.VideoLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GlassPlayer.Models"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="VideoTile" x:DataType="models:VideoInfo">
            <StackPanel Width="272" Spacing="4" Padding="6">
                <Grid Width="260" Height="146" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE8B2;" FontSize="40" Opacity="0.35"/>
                    <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill"/>
                    <Border Visibility="{x:Bind DurationVisibility}" Background="#B0000000" CornerRadius="4" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                        <TextBlock Text="{x:Bind DurationText}" Foreground="White" FontSize="12"/>
                    </Border>
                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                 VerticalAlignment="Bottom" Minimum="0" Maximum="100"/>
                </Grid>
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                <TextBlock Text="{x:Bind Folder}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="40,24,40,32" Spacing="12">
            <Grid>
                <TextBlock Text="Video library" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <TextBox x:Name="FilterBox" PlaceholderText="Filter videos" Width="220" TextChanged="FilterBox_TextChanged"/>
                    <ComboBox x:Name="FolderBox" MinWidth="160" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="SortBox" SelectedIndex="0" MinWidth="150" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Sort: A – Z"/>
                        <ComboBoxItem Content="Sort: Recently added"/>
                        <ComboBoxItem Content="Sort: Folder"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Padding="32" CornerRadius="12" Margin="0,24,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B2;" FontSize="48" Opacity="0.6"/>
                    <TextBlock Text="Add your videos" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose folders on this PC or your NAS. You can add more later in Settings."
                               Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="Add video folder" HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}" Click="AddFolder_Click"/>
                    <TextBlock x:Name="ScanText" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ContinueHeader" Text="Continue watching" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
            <GridView x:Name="ContinueGrid" ItemTemplate="{StaticResource VideoTile}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Continue_ItemClick"/>

            <TextBlock x:Name="AllHeader" Text="All videos" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
            <GridView x:Name="AllGrid" ItemTemplate="{StaticResource VideoTile}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="All_ItemClick"/>
        </StackPanel>
    </ScrollViewer>
</Page>
