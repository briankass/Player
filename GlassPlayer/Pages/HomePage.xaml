<Page
    x:Class="GlassPlayer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GlassPlayer.Models"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="AlbumTile" x:DataType="models:AlbumInfo">
            <StackPanel Width="184" Spacing="4" Padding="6">
                <Grid Width="172" Height="172" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE93C;" FontSize="44" Opacity="0.35"/>
                    <Image Source="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill"/>
                </Grid>
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                <TextBlock Text="{x:Bind Artist}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="40,24,40,32" Spacing="12">
            <Grid>
                <TextBlock Text="Home" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <Button x:Name="ShuffleAllButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" Click="ShuffleAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                        <TextBlock Text="Shuffle all music"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- empty library -->
            <Border x:Name="EmptyPanel" Visibility="Collapsed" Padding="32" CornerRadius="12" Margin="0,24,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEC4F;" FontSize="48" Opacity="0.6"/>
                    <TextBlock Text="Add your music" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose a folder on this PC or your NAS (for example \\nas\music)."
                               Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="Choose music folder" HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}" Click="ChooseFolder_Click"/>
                    <TextBlock x:Name="ScanText" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="RecentHeader" Text="Recently played" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <GridView x:Name="RecentGrid" ItemTemplate="{StaticResource AlbumTile}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Album_ItemClick"/>

            <TextBlock x:Name="AddedHeader" Text="Recently added" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <GridView x:Name="AddedGrid" ItemTemplate="{StaticResource AlbumTile}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Album_ItemClick"/>
        </StackPanel>
    </ScrollViewer>
</Page>
