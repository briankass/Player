<Page
    x:Class="GlassPlayer.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GlassPlayer.Models"
    Background="Transparent">

    <Grid Padding="40,24,40,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Play queue" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <TextBlock x:Name="CountText" Opacity="0.6"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <Button Click="SaveAsPlaylist_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE728;" FontSize="14"/>
                        <TextBlock Text="Save as playlist"/>
                    </StackPanel>
                </Button>
                <Button Click="Clear_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        <TextBlock Text="Clear upcoming"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True"
                  ItemClick="QueueList_ItemClick" RightTapped="QueueList_RightTapped" Padding="0,0,0,24">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="4,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
