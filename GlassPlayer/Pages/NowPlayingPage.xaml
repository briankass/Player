<Page
    x:Class="GlassPlayer.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:GlassPlayer.Services"
    Background="Transparent">

    <Grid CornerRadius="8,0,0,0" RequestedTheme="Dark">
        <!-- full-page glass: album art blurred behind acrylic -->
        <Image x:Name="BgImage" Stretch="UniformToFill"/>
        <Rectangle>
            <Rectangle.Fill>
                <AcrylicBrush TintColor="#FF0A0A0A" TintOpacity="0.5" TintLuminosityOpacity="0.3" FallbackColor="#F0121212"/>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Padding="56,40" ColumnSpacing="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="8" MaxWidth="380">
                <Grid Width="360" Height="360" CornerRadius="14" Background="#33FFFFFF">
                    <FontIcon Glyph="&#xE93C;" FontSize="96" Opacity="0.4"/>
                    <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                </Grid>
                <TextBlock x:Name="TitleText" Text="Nothing playing" Style="{StaticResource TitleTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="2" Margin="0,16,0,0"/>
                <HyperlinkButton x:Name="ArtistLink" Padding="0" FontSize="18" Click="ArtistLink_Click"/>
                <HyperlinkButton x:Name="AlbumLink" Padding="0" Opacity="0.75" Click="AlbumLink_Click"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Click="FixSong_Click" ToolTipService.ToolTip="Fix this song's tags, cover and lyrics source">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EC;" FontSize="14"/>
                            <TextBlock Text="Fix metadata"/>
                        </StackPanel>
                    </Button>
                    <Button Click="FixAlbum_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE93C;" FontSize="14"/>
                            <TextBlock Text="Fix album"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE720;" FontSize="14" Opacity="0.7"/>
                    <TextBlock x:Name="LyricsSource" Text="Lyrics" Opacity="0.7" FontSize="13"/>
                </StackPanel>
                <ListView x:Name="LyricsList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="LyricsList_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:LyricLine">
                            <TextBlock Text="{x:Bind Text}" Opacity="{x:Bind Opacity, Mode=OneWay}"
                                       FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="NoLyricsText" Grid.Row="1" Visibility="Collapsed" Opacity="0.6" FontSize="20"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
