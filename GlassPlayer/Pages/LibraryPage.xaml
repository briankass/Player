<Page
    x:Class="GlassPlayer.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GlassPlayer.Models"
    Background="Transparent">

    <Grid Padding="40,24,40,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="Music library" Style="{StaticResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis"/>

        <Grid Grid.Row="1">
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem Text="Songs" Tag="songs" IsSelected="True"/>
                <SelectorBarItem Text="Albums" Tag="albums"/>
                <SelectorBarItem Text="Artists" Tag="artists"/>
            </SelectorBar>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" MinWidth="140">
                    <ComboBoxItem Content="Sort: A – Z"/>
                    <ComboBoxItem Content="Sort: Artist"/>
                    <ComboBoxItem Content="Sort: Album"/>
                    <ComboBoxItem Content="Sort: Recently added"/>
                </ComboBox>
                <Button Style="{StaticResource AccentButtonStyle}" Click="ShuffleAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                        <TextBlock Text="Shuffle"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Songs -->
        <ListView x:Name="SongsList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True"
                  ItemClick="SongsList_ItemClick" RightTapped="SongsList_RightTapped" Padding="0,0,0,24">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="4,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Artist}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind DisplayAlbum}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" Opacity="0.75" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Albums -->
        <GridView x:Name="AlbumsGrid" Grid.Row="2" Visibility="Collapsed" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="AlbumsGrid_ItemClick" Padding="0,0,0,24">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:AlbumInfo">
                    <StackPanel Width="184" Spacing="4" Padding="6">
                        <Grid Width="172" Height="172" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE93C;" FontSize="44" Opacity="0.35"/>
                            <Image Source="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Artists -->
        <GridView x:Name="ArtistsGrid" Grid.Row="2" Visibility="Collapsed" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="ArtistsGrid_ItemClick" Padding="0,0,0,24">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ArtistInfo">
                    <StackPanel Width="172" Spacing="4" Padding="6">
                        <Grid Width="156" Height="156" CornerRadius="78" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Initial}" FontSize="48" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
