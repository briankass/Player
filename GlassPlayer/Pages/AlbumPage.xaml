<Page
    x:Class="GlassPlayer.Pages.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GlassPlayer.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- glass header: album art blurred behind acrylic -->
        <Grid Height="300" CornerRadius="8,0,0,0" RequestedTheme="Dark">
            <Image x:Name="HeaderBg" Stretch="UniformToFill" VerticalAlignment="Center"/>
            <Rectangle>
                <Rectangle.Fill>
                    <AcrylicBrush TintColor="#FF101010" TintOpacity="0.45" TintLuminosityOpacity="0.35" FallbackColor="#E0181818"/>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Padding="40,32" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="232" Height="232" CornerRadius="10" Background="#33FFFFFF">
                    <FontIcon Glyph="&#xE93C;" FontSize="64" Opacity="0.5"/>
                    <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="ALBUM" FontSize="12" Opacity="0.7" CharacterSpacing="100"/>
                    <TextBlock x:Name="AlbumTitle" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"/>
                    <HyperlinkButton x:Name="ArtistLink" Padding="0" FontSize="18" Click="ArtistLink_Click"/>
                    <TextBlock x:Name="AlbumDetails" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Play_Click" Padding="18,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock Text="Play"/>
                            </StackPanel>
                        </Button>
                        <Button Click="Shuffle_Click" Padding="18,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                                <TextBlock Text="Shuffle"/>
                            </StackPanel>
                        </Button>
                        <Button Click="AddQueue_Click" Padding="18,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock Text="Add to queue"/>
                            </StackPanel>
                        </Button>
                        <Button Click="FixMetadata_Click" Padding="18,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8EC;" FontSize="14"/>
                                <TextBlock Text="Fix metadata"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <ListView x:Name="TrackList" Grid.Row="1" Padding="28,12,28,24" SelectionMode="Single"
                  IsItemClickEnabled="True" ItemClick="TrackList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="4,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind TrackNumberText}" Opacity="0.6" HorizontalAlignment="Right"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Artist}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
