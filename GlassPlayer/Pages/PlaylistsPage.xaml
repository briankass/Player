<Page
    x:Class="GlassPlayer.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassPlayer.Pages"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="PlaylistTile" x:DataType="local:PlaylistTile">
            <StackPanel Width="184" Spacing="4" Padding="6">
                <Grid Width="172" Height="172" CornerRadius="8" Background="{x:Bind Background}">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="48" Foreground="White" Opacity="0.9"/>
                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill"/>
                </Grid>
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="40,24,40,32" Spacing="12">
            <Grid>
                <TextBlock Text="Playlists" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button Click="Import_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                            <TextBlock Text="Import .m3u"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Click="New_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="New playlist"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="Your playlists" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
            <TextBlock x:Name="NoPlaylistsText" Opacity="0.7" TextWrapping="Wrap"
                       Text="No playlists yet. Click New playlist, or right-click songs, albums or folders and choose Add to playlist."/>
            <GridView x:Name="UserGrid" ItemTemplate="{StaticResource PlaylistTile}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Tile_ItemClick" RightTapped="UserGrid_RightTapped"/>

            <TextBlock Text="Automatic" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <GridView x:Name="SmartGrid" ItemTemplate="{StaticResource PlaylistTile}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Tile_ItemClick"/>
        </StackPanel>
    </ScrollViewer>
</Page>
