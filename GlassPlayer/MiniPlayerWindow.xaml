<Window
    x:Class="GlassPlayer.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- album art tint behind everything -->
        <Image x:Name="BgArt" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.35"/>

        <Grid x:Name="DragBar" Padding="12,0,140,0">
            <TextBlock Text="Glass Player" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Padding="14,0,14,12" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Width="104" Height="104" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                  VerticalAlignment="Center">
                <FontIcon Glyph="&#xEC4F;" FontSize="32" Opacity="0.5"/>
                <Image x:Name="ArtImage" Stretch="UniformToFill"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Opacity="0.75" FontSize="13" TextTrimming="CharacterEllipsis"/>
                <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False" Margin="0,2,0,0"
                        ValueChanged="SeekSlider_ValueChanged"/>
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Width="36" Height="36" Padding="0" CornerRadius="18" Background="Transparent" BorderThickness="0"
                                Click="Prev_Click" ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xE892;" FontSize="14"/>
                        </Button>
                        <Button Width="42" Height="42" Padding="0" CornerRadius="21" Style="{StaticResource AccentButtonStyle}"
                                Click="Play_Click" ToolTipService.ToolTip="Play/Pause">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16"/>
                        </Button>
                        <Button Width="36" Height="36" Padding="0" CornerRadius="18" Background="Transparent" BorderThickness="0"
                                Click="Next_Click" ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xE893;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <ToggleButton x:Name="PinButton" Width="36" Height="36" Padding="0" CornerRadius="18" IsChecked="True"
                                      Background="Transparent" BorderThickness="0" Click="Pin_Click" ToolTipService.ToolTip="Keep on top">
                            <FontIcon Glyph="&#xE718;" FontSize="14"/>
                        </ToggleButton>
                        <Button Width="36" Height="36" Padding="0" CornerRadius="18" Background="Transparent" BorderThickness="0"
                                Click="Expand_Click" ToolTipService.ToolTip="Back to full player">
                            <FontIcon Glyph="&#xE740;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
