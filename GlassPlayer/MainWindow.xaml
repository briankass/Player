<Window
    x:Class="GlassPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GlassPlayer.Models"
    xmlns:svc="using:GlassPlayer.Services">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar (doubles as draggable title bar) -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,8,140,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Glass Player" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <Button x:Name="FolderButton" Grid.Column="1" Content="Choose music folder…" Click="FolderButton_Click"/>
            <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Search title, artist, album" TextChanged="SearchBox_TextChanged" MaxWidth="420"/>
            <ComboBox x:Name="BackdropBox" Grid.Column="3" SelectedIndex="0" SelectionChanged="BackdropBox_SelectionChanged" MinWidth="110">
                <ComboBoxItem Content="Mica"/>
                <ComboBoxItem Content="Acrylic"/>
                <ComboBoxItem Content="Mica Alt"/>
            </ComboBox>
            <Button x:Name="UpdateButton" Grid.Column="4" Content="Check for updates" Click="UpdateButton_Click"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Padding="16,0,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="TrackList" Grid.Column="0" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="TrackList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Padding="4,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" Opacity="0.65" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Width="220" Height="220" CornerRadius="12" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image x:Name="ArtImage" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="NowTitle" Text="Nothing playing" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NowArtist" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LyricsSource" Opacity="0.5" FontSize="11"/>
                </StackPanel>
                <ListView x:Name="LyricsList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="LyricsList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:LyricLine">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="16" Padding="0,2"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Transport bar -->
        <Grid Grid.Row="2" Padding="16,8,16,16" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PosText" Text="0:00" VerticalAlignment="Center"/>
                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" ThumbToolTipValueConverter="{x:Null}"
                        ValueChanged="SeekSlider_ValueChanged"/>
                <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button Content="Prev" Click="Prev_Click"/>
                <Button x:Name="PlayButton" Content="Play" MinWidth="72" Click="PlayPause_Click"/>
                <Button Content="Next" Click="Next_Click"/>
                <TextBlock Text="Vol" VerticalAlignment="Center" Margin="24,0,0,0"/>
                <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
