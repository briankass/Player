<Window
    x:Class="GlassPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- colour layer for the Blur/Clear glass effects (frosting is Root's own background) -->
        <Rectangle x:Name="TintLayer" Grid.RowSpan="3" IsHitTestVisible="False"/>

        <!-- Title bar: draggable, nothing clickable so it never collides with the caption buttons -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE768;" FontSize="11" Margin="2,0,0,0"
                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Glass Player" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" FontSize="13"/>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="260"
                        IsBackButtonVisible="Visible"
                        IsBackEnabled="False"
                        IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        BackRequested="Nav_BackRequested"
                        ItemInvoked="Nav_ItemInvoked">
            <NavigationView.Resources>
                <!-- opacity is driven by the "Panel opacity" slider so the glass can show through -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#1C1C1C" Opacity="0.3"/>
            </NavigationView.Resources>
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search songs, albums, artists"
                                QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted"/>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Music library" Tag="library">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC4F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Now playing" Tag="nowplaying">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Play queue" Tag="queue">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90B;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Fix metadata &amp; art" Tag="metadata" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Informational" Margin="24,12,24,0"/>
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="ContentFrame_Navigated"/>
            </Grid>
        </NavigationView>

        <!-- Player bar -->
        <Grid x:Name="PlayerBar" Grid.Row="2" Padding="20,6,20,14" RowSpacing="2"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PosText" Text="0:00" VerticalAlignment="Center" FontSize="12" Opacity="0.8"/>
                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.5"
                        IsThumbToolTipEnabled="False" ValueChanged="SeekSlider_ValueChanged"/>
                <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontSize="12" Opacity="0.8"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- now playing info: click to open Now Playing -->
                <Button x:Name="NowPlayingButton" Background="Transparent" BorderThickness="0" Padding="4"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Left" Click="NowPlayingButton_Click"
                        ToolTipService.ToolTip="Open Now playing">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Grid Width="64" Height="64" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xEC4F;" FontSize="24" Opacity="0.5"/>
                            <Image x:Name="BarArt" Stretch="UniformToFill"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" MaxWidth="320">
                            <TextBlock x:Name="BarTitle" Text="Nothing playing" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="BarArtist" Text="Pick something from your library" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton x:Name="ShuffleButton" Width="40" Height="40" Padding="0" CornerRadius="20"
                                  Background="Transparent" BorderThickness="0" Click="Shuffle_Click"
                                  ToolTipService.ToolTip="Shuffle">
                        <FontIcon Glyph="&#xE8B1;" FontSize="16"/>
                    </ToggleButton>
                    <Button Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                            Click="Prev_Click" ToolTipService.ToolTip="Previous">
                        <FontIcon Glyph="&#xE892;" FontSize="18"/>
                    </Button>
                    <Button x:Name="PlayButton" Width="56" Height="56" Padding="0" CornerRadius="28"
                            Style="{StaticResource AccentButtonStyle}" Click="PlayPause_Click" ToolTipService.ToolTip="Play/Pause">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="22"/>
                    </Button>
                    <Button Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                            Click="Next_Click" ToolTipService.ToolTip="Next">
                        <FontIcon Glyph="&#xE893;" FontSize="18"/>
                    </Button>
                    <ToggleButton x:Name="RepeatButton" Width="40" Height="40" Padding="0" CornerRadius="20"
                                  Background="Transparent" BorderThickness="0" Click="Repeat_Click"
                                  ToolTipService.ToolTip="Repeat">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="16"/>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                    <Button Width="40" Height="40" Padding="0" CornerRadius="20" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Volume">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16"/>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE767;" FontSize="14"/>
                                    <Slider x:Name="VolumeSlider" Width="180" Minimum="0" Maximum="100"
                                            ValueChanged="VolumeSlider_ValueChanged"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Width="40" Height="40" Padding="0" CornerRadius="20" Background="Transparent" BorderThickness="0"
                            Click="Lyrics_Click" ToolTipService.ToolTip="Lyrics">
                        <FontIcon Glyph="&#xE720;" FontSize="16"/>
                    </Button>
                    <Button Width="40" Height="40" Padding="0" CornerRadius="20" Background="Transparent" BorderThickness="0"
                            Click="Queue_Click" ToolTipService.ToolTip="Play queue">
                        <FontIcon Glyph="&#xE90B;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
